# Copy to config/wifi.env and fill in before building. config/wifi.env is gitignored, so real
# credentials never reach the repository.
#
# The build bakes the network into /etc/wpa_supplicant/wpa_supplicant-wlan0.conf and also writes
# the same values to /wifi.conf on the FAT boot partition, so the network can be changed later by
# editing the SD card from a PC (wifi-provision.service applies it at boot).
WIFI_SSID="YOUR_SSID"
WIFI_PSK="YOUR_PASSPHRASE"
# ISO 3166-1 alpha-2 country code, or 00 for the world regulatory domain.
WIFI_COUNTRY=00
