# Copy to config/wifi.env and fill in before building. config/wifi.env is gitignored, so real
# credentials never reach the repository.
#
# One file may describe several networks (2.4 GHz and 5 GHz of the same router, home and phone
# hotspot, ...): number the entries from 1, up to 8. wpa_supplicant joins the strongest visible one.
# WIFI_PRIORITY_n is optional — a larger value makes wpa_supplicant prefer that network when more
# than one is in range.
#
# The build bakes these networks into /etc/wpa_supplicant/wpa_supplicant-wlan0.conf as hashes only.
# To change them later without reflashing, write this same file to /wifi.conf on the FAT boot
# partition; wifi-provision.service applies it at boot.
WIFI_COUNTRY=00
WIFI_SSID_1="YOUR_SSID"
WIFI_PSK_1="YOUR_PASSPHRASE"
# WIFI_SSID_2="YOUR_SSID_5G"
# WIFI_PSK_2="YOUR_PASSPHRASE"
# WIFI_PRIORITY_2=20
