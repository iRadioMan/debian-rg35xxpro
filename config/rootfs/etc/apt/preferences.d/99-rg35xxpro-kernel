# RG35XX Pro (mainline kernel on the boot partition, no initramfs):
# never let apt install a distro kernel or an initramfs generator — the image boots /Image + DTB
# straight from the FAT partition via U-Boot's boot.scr.
Package: linux-image-*
Pin: release *
Pin-Priority: -1

Package: linux-image
Pin: release *
Pin-Priority: -1

Package: linux-base
Pin: release *
Pin-Priority: -1

Package: initramfs-tools
Pin: release *
Pin-Priority: -1

Package: initramfs-tools-core
Pin: release *
Pin-Priority: -1

Package: dracut
Pin: release *
Pin-Priority: -1
