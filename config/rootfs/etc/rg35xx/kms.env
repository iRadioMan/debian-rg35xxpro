# KMS/DRM-only environment: ES-DE and games render straight to /dev/dri/card1 (sun4i-drm) with
# GLES2. Never load this for the Wayland desktop session.
SDL_AUDIODRIVER=pulseaudio
SDL_VIDEODRIVER=kmsdrm
SDL_VIDEO_GL_DRIVER=libGLESv2.so.2
SDL_VIDEO_EGL_DRIVER=libEGL.so.1
SDL_KMSDRM_REQUIRE_DRM_MASTER=1
# armhf ports (PortMaster multiarch) load their DRI drivers from the second path.
LIBGL_DRIVERS_PATH=/usr/lib/aarch64-linux-gnu/dri:/usr/lib/arm-linux-gnueabihf/dri
