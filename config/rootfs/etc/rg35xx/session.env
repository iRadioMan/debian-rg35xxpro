# Environment shared by every graphical session (ES-DE, RetroArch, ports, labwc).
# Loaded with EnvironmentFile= from rg35xx-es.service, rg35xx-desktop.service and
# rg35xx-game.service. KMS/DRM-only variables live in kms.env: the Wayland desktop must not
# inherit SDL_VIDEODRIVER=kmsdrm or every SDL client started from labwc would fight for DRM.
HOME=/home/gamer
XDG_RUNTIME_DIR=/run/user/1000
PULSE_SERVER=unix:/run/user/1000/pulse/native
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TERM=linux
# H700 built-in gamepad: vendor 0x484B, product 0x14DF, bus HOST (0x19), version 0x0100.
# The DTS labels the east button A and the south button B (button-a = BTN_EAST, button-b =
# BTN_SOUTH), so SDL "a" is b1, not b0, and SDL x/y follow position (west/north). Identical to
# the entry ROCKNIX ships for this exact GUID.
SDL_GAMECONTROLLERCONFIG="1900f6a24b480000df14000000010000,H700 Gamepad,platform:Linux,x:b3,a:b1,b:b0,y:b2,back:b8,guide:b10,start:b9,dpleft:b15,dpdown:b14,dpright:b16,dpup:b13,leftshoulder:b4,lefttrigger:b6,rightshoulder:b5,righttrigger:b7,leftstick:b11,rightstick:b12,leftx:a0,lefty:a1,rightx:a2,righty:a3,"
# PortMaster's Python SDL2 wrapper looks in /usr/lib only; Debian ships SDL2 in the multiarch dir.
PYSDL2_DLL_PATH=/usr/lib/aarch64-linux-gnu:/usr/lib
# PortMaster logs through python; without this its output is lost when the GUI dies mid-write.
PYTHONUNBUFFERED=1
