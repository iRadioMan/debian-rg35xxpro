[Unit]
Description=RG35XX Pro: labwc desktop on tty1
Conflicts=rg35xx-es.service rg35xx-terminal.service rg35xx-game.service getty@tty1.service
After=seatd.service bluetooth.service sound.target network.target rg35xx-userdata-seed.service
Wants=seatd.service bluetooth.service sound.target
# No OnFailure=: the ExecStopPost helper already decides where a session that ended on its
# own should go, and a failure *during a switch* would make it start a third session that
# cancels the switch the user asked for.

[Service]
Type=simple
User=gamer
# Deliberately no TTYPath/TTYReset/StandardInput=tty: these sessions do not read the console, and
# holding tty1 as their controlling terminal makes them die with SIGHUP when the *previous* mode's
# getty is torn down (vhangup() on the VT). Output goes to the journal instead.
StandardOutput=journal
StandardError=journal
# No kms.env here: the desktop is Wayland, and SDL_VIDEODRIVER=kmsdrm would be inherited by
# every SDL application launched from labwc.
EnvironmentFile=-/etc/rg35xx/session.env
Environment=RG35XX_DESKTOP=1
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=labwc
Environment=XDG_VTNR=1
Environment=WLR_BACKENDS=drm,libinput
Environment=WLR_RENDERER=gles2
# card0 is the render-only Panfrost node; the modeset device is sun4i-drm on card1.
Environment=WLR_DRM_DEVICES=/dev/dri/card1
Environment=WLR_NO_HARDWARE_CURSORS=1
ExecStartPre=+/usr/local/bin/rg35xx-session-prepare desktop
ExecStart=/usr/bin/labwc
ExecStopPost=+/usr/local/bin/rg35xx-session-after-desktop
KillMode=control-group
TimeoutStopSec=10
Restart=no
