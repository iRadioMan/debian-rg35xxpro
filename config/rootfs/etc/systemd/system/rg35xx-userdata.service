[Unit]
Description=RG35XX Pro: create the /roms user-data partition on first boot
Documentation=file:///usr/local/share/rg35xxpro/README.md
# DefaultDependencies=no is required: this has to run inside local-fs.target, before roms.mount,
# and a normal service would be ordered after basic.target — after the mount it must precede.
DefaultDependencies=no
After=local-fs-pre.target
Before=roms.mount
ConditionPathIsMountPoint=!/roms

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rg35xx-userdata

[Install]
WantedBy=local-fs.target
