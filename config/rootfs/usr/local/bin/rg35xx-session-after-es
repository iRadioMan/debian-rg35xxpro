#!/bin/sh
# ExecStopPost= of rg35xx-es.service. ES-DE stopped: either a switch was requested (target is
# already set by rg35xx-session), the machine is going down, or ES died on its own. The last case
# drops to the console instead of restarting a frontend that just crashed.
set -eu

# A shutdown/reboot is already in progress: systemd would refuse the start job anyway, and this
# keeps the journal clean. (Do not test for /run/systemd/shutdown: that directory exists on a
# running system too, and the guard would then never fire.)
[ "$(systemctl is-system-running 2>/dev/null)" = "stopping" ] && exit 0

target=$(cat /run/rg35xx/target 2>/dev/null || true)
# Any explicit target means a switch (or a restart of this very unit) was requested: stay quiet.
case "$target" in
  es | game | desktop | terminal | poweroff | reboot) exit 0 ;;
esac

printf 'terminal\n' > /run/rg35xx/target
exec systemctl --no-block start rg35xx-terminal.service
