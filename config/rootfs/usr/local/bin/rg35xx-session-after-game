#!/bin/sh
# ExecStopPost= of rg35xx-game.service: the game or port exited, go back to ES-DE and let the
# periodic boot report run again (rg35xx-free-memory stopped it to keep the RAM for the game).
set -eu

# A poweroff/reboot issued from inside the game must not resurrect the frontend.
# (Do not test for /run/systemd/shutdown: the directory exists on a running system too.)
[ "$(systemctl is-system-running 2>/dev/null)" = "stopping" ] && exit 0

systemctl start boot-report.timer >/dev/null 2>&1 || true

# Hand the switch to the helper instead of starting ES-DE here. Children of a port outlive its main
# process (PortMaster re-execs itself through sudo, and that sudo ignores SIGTERM), and while they
# live this hook runs inside the very cgroup they occupy: killing them from here would kill the hook
# itself, and ES-DE started on top of them fails with "kmsdrm not available". The helper runs
# outside every session, force-clears such leftovers, waits for this unit's stop job to finish and
# only then starts the frontend. previous= is left alone: leaving a game returns to the frontend, and
# the frontend still remembers the session it was entered from (desktop or console).
printf 'es\n' > /run/rg35xx/target
exec /usr/bin/systemd-run --quiet --collect --no-block --unit=rg35xx-switch-after-game-$$ \
  /usr/local/bin/rg35xx-session-apply es
