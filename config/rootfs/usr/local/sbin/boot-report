#!/bin/sh
# Dump boot + network state to the FAT boot partition (field diagnostics without a keyboard).
[ -d /boot/firmware ] || exit 0
mountpoint -q /boot/firmware || exit 0
TMP=/boot/firmware/.boot-report.tmp
OUT=/boot/firmware/boot-report.txt
{
  echo "=== generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ') uptime=$(cut -d' ' -f1 /proc/uptime) ==="
  echo "--- uname ---"; uname -a
  echo "--- cmdline ---"; cat /proc/cmdline
  echo "--- ip ---"; ip -br a 2>&1
  echo "--- iw dev ---"; iw dev 2>&1 | head -40
  echo "--- iw link ---"; iw dev wlan0 link 2>&1 | head -20
  echo "--- rfkill ---"; rfkill list 2>&1 | head -20
  echo "--- networkctl ---"; networkctl status wlan0 --no-pager 2>&1 | head -25
  echo "--- supplicant unit ---"; systemctl is-active wpa_supplicant@wlan0 wifi-provision rg35xx-wifi-unblock 2>&1
  echo "--- wpa_cli ---"; wpa_cli -i wlan0 status 2>&1 | head -15
  echo "--- wifi journal ---"
  journalctl -b -n 80 --no-pager -u wpa_supplicant@wlan0 -u wifi-provision -u rg35xx-wifi-unblock 2>&1
  echo "--- regulatory ---"; iw reg get 2>&1 | head -20
  echo "--- units ---"; systemctl is-active ssh systemd-networkd systemd-resolved wpa_supplicant@wlan0 2>&1
  echo "--- user manager ---"; systemctl is-active user@1000 2>&1
  systemctl status user@1000 --no-pager -n 8 2>&1 | head -20
  echo "--- runtime dir ---"; ls -ld /run/user /run/user/1000 2>&1
  echo "--- cgroup mounts ---"; mount | grep -E 'cgroup' 2>&1 | head -6
  echo "--- user units ---"; systemctl --user -M gamer@ is-active pipewire wireplumber 2>&1 | head -5
  echo "--- wpa_supplicant cfg ---"; head -20 /etc/wpa_supplicant/wpa_supplicant-wlan0.conf 2>&1
  echo "--- userdata ---"; findmnt /mnt/userdata /roms 2>&1; df -h /roms 2>&1
  echo "--- userdata fsck ---"; cat /run/rg35xx-userdata-fsck.log 2>&1 | tail -80; journalctl -b -u rg35xx-userdata-check.service --no-pager 2>&1 | tail -40
  echo "--- desktop session log ---"; { cat /run/rg35xx/desktop.log 2>/dev/null || cat /run/user/1000/rg35xx-desktop.log 2>/dev/null; } | tail -60
  echo "--- game log ---"; { cat /run/rg35xx/game.log 2>/dev/null || cat /run/user/1000/rg35xx-game.log 2>/dev/null; } | tail -60
  echo "--- portmaster log ---"; tail -60 /roms/ports/PortMaster/log.txt 2>&1
  echo "--- usb ---"; lsusb 2>&1 | head -20
  echo "--- input devices ---"; grep -E '^N:|^H:' /proc/bus/input/devices 2>&1 | head -40
  echo "--- recent journal (300 lines) ---"
  journalctl -b -n 300 --no-pager 2>&1
} > "$TMP" 2>&1
mv -f "$TMP" "$OUT"
sync
exit 0
