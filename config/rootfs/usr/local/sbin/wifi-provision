#!/bin/sh
# Apply Wi-Fi settings from the FAT boot partition. A wifi.conf there replaces the baked-in
# configuration, so networks can be changed by editing the card from a PC — no reflash needed.
#
# The file format is the same one the build reads from config/wifi.env and can hold several
# networks; wifi-config-gen renders it, so both paths share one implementation.
set -eu
CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
SRC=/boot/firmware/wifi.conf
GEN=/usr/local/sbin/wifi-config-gen

[ -r "$SRC" ] || exit 0

umask 077
tmp=$(mktemp /etc/wpa_supplicant/.wpa_supplicant-wlan0.XXXXXX)
trap 'rm -f "$tmp"' EXIT

"$GEN" "$SRC" > "$tmp"

# A file that still has placeholders renders the header and nothing else: keep the baked network.
if ! grep -q '^network=' "$tmp"; then
  exit 0
fi

# Rewriting an identical config on every boot is a pointless SD write.
if cmp -s "$tmp" "$CONF"; then
  exit 0
fi

chmod 600 "$tmp"
mv -f "$tmp" "$CONF"
sync
exit 0
