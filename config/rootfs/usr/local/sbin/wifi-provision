#!/bin/sh
# Apply Wi-Fi settings from the FAT boot partition. Any wifi.conf there overrides the baked-in config,
# so networks can be changed by editing the card from a PC — no reflash needed.
set -e
CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
SRC=/boot/firmware/wifi.conf
[ -r "$SRC" ] || exit 0
# shellcheck disable=SC1090
. "$SRC"
# Tolerate CRLF if wifi.conf was edited on Windows.
WIFI_SSID=$(printf '%s' "${WIFI_SSID:-}" | tr -d '\r')
WIFI_PSK=$(printf '%s' "${WIFI_PSK:-}" | tr -d '\r')
WIFI_COUNTRY=$(printf '%s' "${WIFI_COUNTRY:-}" | tr -d '\r')
case "${WIFI_SSID:-}" in "" | "YOUR_SSID" | "CHANGEME") exit 0 ;; esac
case "${WIFI_PSK:-}" in "" | "YOUR_PASSPHRASE" | "CHANGEME") exit 0 ;; esac
umask 077
block=$(wpa_passphrase "$WIFI_SSID" "$WIFI_PSK") || exit 1
# Stage next to the destination (same filesystem, so mv is atomic) and only write when the content
# actually changes: rewriting an identical config on every boot is a pointless SD write.
tmp=$(mktemp /etc/wpa_supplicant/.wpa_supplicant-wlan0.XXXXXX)
{
  echo "country=${WIFI_COUNTRY:-00}"
  echo "ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev"
  echo "update_config=1"
  echo "powersave=0"
  echo
  # wpa_passphrase keeps the passphrase in a comment next to the hash; do not ship it twice.
  printf '%s\n' "$block" | sed -n '/network={/,$p' | sed -e '/^[[:space:]]*#psk=/d'
} > "$tmp"
if cmp -s "$tmp" "$CONF"; then
  rm -f "$tmp"
  exit 0
fi
chmod 600 "$tmp"
mv -f "$tmp" "$CONF"
sync
exit 0
