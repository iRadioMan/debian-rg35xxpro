diff -r a/pylibs/harbourmaster/util.py b/pylibs/harbourmaster/util.py
--- a/pylibs/harbourmaster/util.py	2026-11-15 12:35:10.126582000 +0700
+++ b/pylibs/harbourmaster/util.py	2026-11-15 12:35:10.126582000 +0700
@@ -281,15 +281,26 @@
 
 
 def runtime_nicename(runtime):
-    if runtime.startswith("frt"):
-        return ("Godot/FRT {version}").format(version=runtime.split('_', 1)[1].rsplit('.', 1)[0])
+    if isinstance(runtime, (list, tuple)):
+        return oc_join([runtime_nicename(item) for item in runtime])
 
-    if runtime.startswith("mono"):
-        return ("Mono {version}").format(version=runtime.split('-', 1)[1].rsplit('-', 1)[0])
+    if not isinstance(runtime, str):
+        return runtime
 
-    if "jdk" in runtime and runtime.startswith("zulu11"):
-        return ("JDK {version}").format(version=runtime.split('-')[2][3:])
+    try:
+        if runtime.startswith("frt"):
+            return ("Godot/FRT {version}").format(version=runtime.split('_', 1)[1].rsplit('.', 1)[0])
 
+        if runtime.startswith("mono"):
+            return ("Mono {version}").format(version=runtime.split('-', 1)[1].rsplit('-', 1)[0])
+
+        if "jdk" in runtime and runtime.startswith("zulu11"):
+            return ("JDK {version}").format(version=runtime.split('-')[2][3:])
+
+    except IndexError:
+        ## Hand-written runtime names need not follow the "<kind>-<version>" pattern.
+        return runtime
+
     return runtime
 
 
